# false = use the real Node/Express API (server/index.js)   true = demo data in the browser only
VITE_USE_MOCK=false

# Leave EMPTY in development (Vite proxies to port 5050).
# In production put your API URL, e.g. https://api.yourdomain.com
VITE_API_URL=

# Lock this admin to the India / IE Marbles site
VITE_SITE=india

# Used for the "View website" links
VITE_INDIA_URL=http://localhost:3000
VITE_AUSTRALIA_URL=http://localhost:3001
